@import "~/.cache/wal/colors-rofi.rasi"
@import "~/.cache/rofi/colors.rasi"
@import "~/.cache/rofi/font-13.rasi"

configuration {
    click-to-exit: true;
    modi: "drun";
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
    icon-theme: "Papirus";
}

* {
    window-bg-color: @popup-bg;
    unselected-bg-color: transparent;
}

window {
    width: 60%;
    height: 60%;
    border: 0px solid;
    border-radius: 12px;
    background-color: @popup-bg;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 0px;
}

inputbar {
    background-color: transparent;
    children: [ entry ];
    padding: 12px 16px;
    border: 0px;
}

entry {
    background-color: transparent;
    text-color: @color1;
    placeholder: "Search...";
    placeholder-color: #4a4a4a;
}

prompt, case-indicator {
    enabled: false;
}

listview {
    background-color: transparent;
    border: 0px;
    padding: 8px 12px;
    spacing: 8px;
    columns: 5;
    lines: 4;
    layout: vertical;
    fixed-columns: true;
    fixed-height: true;
}

scrollbar {
    background-color: transparent;
    handle-color: @border-muted;
}
element {
    padding: 12px 8px;
    border-radius: 10px;
    orientation: vertical;
    spacing: 6px;
    background-color: transparent;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element selected.normal,
element selected.active,
element selected.urgent {
   background-color: @selected-bg;
}
element-icon {
    background-color: transparent;
    size: 48px;              /* was 48 */
    horizontal-align: 0.5;
}
element-text {
    background-color: transparent;
    text-color: @foreground;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element selected.normal element-text,
element selected.active element-text,
element selected.urgent element-text {
    text-color: @text-on-accent;
}
