@import "~/.cache/rofi/colors.rasi"
@import "~/.cache/rofi/font-11.rasi"
@import "~/.cache/wal/colors-rofi.rasi"

configuration {
    click-to-exit: true;
    modi:          "dmenu";
    show-icons:    false;
}

* {
    window-bg-color:     @popup-bg;
    unselected-bg-color: transparent;
}

window {
    width:            420px;
    height:           320px;
    border:           0px solid;
    border-radius:    12px;
    background-color: @window-bg-color;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    spacing:          8px;
    padding:          10px;
}

inputbar {
    background-color: transparent;
    children:         [ entry ];
    padding:          8px 10px;
    border:           0px;
}

entry {
    background-color: transparent;
    text-color:       @foreground;
    font-family:      "Satoshi Variable";
    placeholder:      "Search...";
    placeholder-color:@text-dim;
}

prompt, case-indicator {
    enabled: false;
}

listview {
    background-color: transparent;
    border:           0px;
    padding:          0px;
    spacing:          8px;
    columns:          3;
    lines:            4;
    layout:           vertical;
    fixed-columns:    true;
    fixed-height:     true;
    scrollbar:        true;
    cycle:            false;
}

scrollbar {
    background-color: transparent;
    handle-color:     @border-muted;
    width:            4px;
    padding:          0px 4px;
}

element {
    background-color: transparent;
    padding:          10px 6px;
    border-radius:    10px;
    orientation:      vertical;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @selected-bg;
}

element-text {
    background-color: transparent;
    text-color:       @foreground;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

element selected.normal element-text,
element selected.active element-text,
element selected.urgent element-text {
    text-color: @text-on-accent;
}
